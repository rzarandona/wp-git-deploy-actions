{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deploy-agent.invalid/schemas/release-request/v1",
  "title": "release-request/v1",
  "description": "Technical Specification v0.6.0 §F.3a (D-46). One website release: the signed body carries the manifest, the artifact carries the managed trees. Strict: unknown fields are rejected; a new field requires a new schema version. Parsed only from the signed raw bytes (≤ 64 KiB, depth ≤ 8). The parser additionally requires manifest.components to be sorted by type (plugin before theme) then slug bytes, with no duplicate (type, slug); JSON Schema cannot express that.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_id", "environment", "mapping", "artifact", "manifest"],
  "properties": {
    "schema": { "const": "release-request/v1" },
    "request_id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
    "environment": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$" },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch", "exclusions_sha256"],
      "properties": {
        "epoch": { "type": "integer", "minimum": 1, "maximum": 4611686018427387903 },
        "exclusions_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "sha256", "size"],
      "properties": {
        "format": { "const": "wp-release-zip/v1" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 1073741824 }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components"],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "slug", "tree_sha256"],
            "properties": {
              "type": { "enum": ["plugin", "theme"] },
              "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$" },
              "tree_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "version": { "type": "string", "pattern": "^[\\x20-\\x7e]{1,64}$" },
              "database_effect": { "enum": ["none", "backward_compatible", "unknown", "irreversible"], "default": "unknown" }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
        "repository": { "type": "string", "pattern": "^[\\x21-\\x7e]{1,200}$" },
        "repository_id": { "type": "string", "pattern": "^[0-9A-Za-z_-]{1,64}$" },
        "ref": { "type": "string", "pattern": "^[\\x21-\\x7e]{1,255}$" },
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
        "path": { "type": "string", "pattern": "^[\\x20-\\x7e]{0,255}$" }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" },
        "run_id": { "type": "string", "pattern": "^[0-9A-Za-z_-]{1,64}$" },
        "run_attempt": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "run_url": { "type": "string", "pattern": "^https://[\\x21-\\x7e]{1,500}$" },
        "workflow": { "type": "string", "pattern": "^[\\x20-\\x7e]{1,255}$" },
        "actor": { "type": "string", "pattern": "^[\\x21-\\x7e]{1,100}$" },
        "created_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "dry_run": { "type": "boolean" } }
    }
  }
}
